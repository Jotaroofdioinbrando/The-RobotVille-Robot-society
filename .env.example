# Chaves das 3 APIs de IA
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Chaves reserva opcionais (usadas automaticamente se a chave principal falhar)
CEREBRAS_API_KEY_2=
OPENROUTER_API_KEY_2=
GEMINI_API_KEY_2=

# Modelos (opcional trocar, já vem com um padrão)
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_MODEL=openrouter/free
GEMINI_MODEL=gemini-3.5-flash-lite

# Banco Upstash Redis (crie grátis em https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Senha inventada por você, usada pra proteger /api/tick e /api/reset
TICK_SECRET=troque-por-uma-senha-aleatoria-sem-acentos
