# Chaves das 3 APIs de IA
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Modelos (opcional trocar, já vem com um padrão)
CEREBRAS_MODEL=llama-3.3-70b
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-5.4-mini

# Banco Upstash Redis (crie grátis em https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Senha inventada por você, usada pra proteger /api/tick e /api/reset
TICK_SECRET=troque-por-uma-senha-aleatoria
